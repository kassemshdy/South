# Frontend configuration (development only).
# The dev server proxies /api and /media to the backend, so no API URL is
# needed at build time — the SPA always calls same-origin paths.

# Where the Vite dev server proxies API requests. Use http://api:8000 under
# Docker Compose; the default is fine when running the backend locally.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Sentry error tracking (project: dotcom-yj / south-web). Leave unset locally
# — Sentry.init is skipped entirely without a DSN. Set on the web service in
# Railway for staging/production. A frontend DSN ships in the bundle and is
# public by design; it only permits writing events, never reading them.
VITE_SENTRY_DSN=
