{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	# Liveness for the platform's healthcheck; never proxied.
	handle /healthz {
		respond "ok" 200
	}

	# Hashed build output is safe to cache indefinitely and needs no
	# server-side logic — served directly, no round-trip to the API.
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	# Everything else — /api/*, /media/*, and every page route (/, /business/*,
	# /talent/*, /products/*, /dashboard/*, /admin/*, a hard refresh on any
	# client-side route) — goes to the API. It serves the exact same built
	# files for a real static request (favicon, the share image, an
	# unhashed asset) and, for an HTML page, injects real per-route SEO tags
	# with its own explicit Cache-Control. Previously only /business/* was
	# proxied, so /talent/* and every other route silently never got the
	# server-rendered tags this app builds for them, and index.html's
	# Cache-Control was set here (unconditionally "no-cache") rather than by
	# whatever actually renders the response — this is the one place that
	# now decides both, so the two can't drift out of sync again.
	@api {
		path /api/*
		path /media/*
	}
	handle @api {
		# Caddy forwards X-Forwarded-* by default, which is what lets the API
		# build absolute canonical and OG URLs on the public host.
		reverse_proxy {$API_INTERNAL_HOST:api.railway.internal:8000}
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle {
		reverse_proxy {$API_INTERNAL_HOST:api.railway.internal:8000}
	}
}
