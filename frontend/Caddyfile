{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	# Liveness for the platform's healthcheck; never proxied.
	handle /healthz {
		respond "ok" 200
	}

	# Every route — hashed assets included — goes to the API, which is the
	# single source of truth for the built SPA. This image used to build its
	# own independent copy of dist/ and serve /assets/* from it directly,
	# which meant two separate `npm run build` runs (one here, one in
	# backend/Dockerfile) had to produce byte-identical content hashes to
	# stay in sync. They didn't: index.html (served by the API) referenced a
	# JS bundle hash that this image's own /assets/ didn't have, 404ing the
	# bundle and leaving every visitor on a blank page. There is now exactly
	# one build of the frontend that anything is ever served from.
	@assets path /assets/*
	handle @assets {
		reverse_proxy {$API_INTERNAL_HOST:api.railway.internal:8000}
		header Cache-Control "public, max-age=31536000, immutable"
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle {
		# Caddy forwards X-Forwarded-* by default, which is what lets the API
		# build absolute canonical and OG URLs on the public host.
		reverse_proxy {$API_INTERNAL_HOST:api.railway.internal:8000}
	}
}
