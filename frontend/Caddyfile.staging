# ---------------------------------------------------------------------------
# Staging front (the owners' request, 27 Oct 2026): the frontend built from
# the develop-claude branch, on the LIVE API and data.
#
# Unlike the live Caddyfile, this one serves its own build: the live web
# service forwards every route to the API, which serves the live bundle, so
# a copy of it would only ever show production. Here only data goes to the
# API -- /api, /media, the sitemap -- and the pages and assets come from
# this image's /srv.
#
# What that means for whoever uses it: everything they see and save is the
# real site's data, through the real API and its rules. A backend change on
# develop-claude is not here until it is released; a new endpoint answers
# 404 and the page has to cope. And it is kept out of search engines.
# ---------------------------------------------------------------------------
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	# Never indexed: a second copy of the site would compete with the real one.
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}

	# The pages come from /srv rather than the API, so the API's security
	# headers never reach them; the same ones are set here. The policy must
	# match DEFAULT_CONTENT_SECURITY_POLICY in backend/app/core/config.py --
	# backend/tests/test_hardening.py fails when the two drift.
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://challenges.cloudflare.com https://www.googletagmanager.com https://www.clarity.ms https://scripts.clarity.ms; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.clarity.ms https://*.ingest.sentry.io https://*.ingest.de.sentry.io; frame-src https://challenges.cloudflare.com https://www.youtube-nocookie.com https://www.youtube.com https://www.google.com https://maps.google.com https://www.instagram.com"
		-Server
	}

	# Larger bodies are refused here, before the API spools them to disk.
	# The biggest legitimate one is a business application: two 10MB ID
	# scans and a 5MB logo.
	request_body {
		max_size 32MB
	}

	@data path /api/* /media/* /sitemap.xml
	handle @data {
		reverse_proxy {$API_INTERNAL_HOST:api.railway.internal:8000}
	}

	@assets path /assets/*
	handle @assets {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
