# ---------------------------------------------------------------------------
# دليل الجنوب — backend configuration
# Copy to .env and adjust. Never commit a real .env.
# ---------------------------------------------------------------------------

APP_ENV=development            # development | test | production
DEBUG=false
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:5173

# --- Database --------------------------------------------------------------
# docker compose provides this automatically; Railway injects its own value.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/south_dev

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=20160
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# How many trusted reverse proxies sit in front of the API. The client address
# (used for per-IP rate limits) is read this many entries from the RIGHT of
# X-Forwarded-For; everything left of it is client-supplied and ignored.
# 1 for local/single-proxy. The Railway deployment (edge -> Caddy -> API) is 2:
# set TRUSTED_PROXY_HOPS=2 on api and api-develop.
TRUSTED_PROXY_HOPS=1
# Content-Security-Policy. Leave unset to use the built-in allowlist in
# app/core/config.py; set it to override per environment. Setting it to an
# EMPTY value sends no CSP at all -- only do that deliberately.
# CONTENT_SECURITY_POLICY=

# --- Storage ---------------------------------------------------------------
STORAGE_BACKEND=local          # local | s3
STORAGE_LOCAL_DIR=var/media
MAX_UPLOAD_BYTES=5242880
MAX_GALLERY_IMAGES=10
MAX_VERIFICATION_DOC_BYTES=10485760

# Required when STORAGE_BACKEND=s3 (works with S3, Cloudflare R2, Backblaze, MinIO)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Administrator bootstrap ----------------------------------------------
# Used by scripts/seed.py. There is no default password: choose your own, even
# locally. A deployed process refuses to start without one (see
# Settings.enforce_production_safety).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=مدير المنصة

# The password scripts/seed.py puts on the demo owner accounts, so their
# dashboards can be opened without issuing credentials by hand. The end-to-end
# suite signs in with it. Refused in production — these phone numbers are in
# the repository, so their password would be too.
SEED_OWNER_PASSWORD=DemoOwner!123

# --- Error tracking --------------------------------------------------------
# Sentry project: dotcom-yj / south-api. Leave unset locally — without a DSN
# the SDK is never initialised, so local tracebacks stay local.
SENTRY_DSN=
# Fraction of requests traced (0.0-1.0). Performance data is far higher volume
# than errors; keep this low outside a deliberate investigation.
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Telegram archive ------------------------------------------------------
# Every save a user makes (applications with their ID scans, orders, products,
# reviews) posted to a Telegram chat. Leave both unset locally: nothing is
# sent without both. The token is a secret -- Railway variable only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Attach photos, ID scans, CVs and papers too. Off: details only.
TELEGRAM_SEND_FILES=false
# Ties an error to the deploy that caused it. On Railway, set this to
# ${{RAILWAY_GIT_COMMIT_SHA}} in the service variables.
SENTRY_RELEASE=

# --- Third-party commerce (docs/COMMERCE.md) -------------------------------
# A shop's own Shopify store, connected through Janobona's Shopify app. All
# three unset: no Connect button, every Shopify route answers 404. The
# secret and the encryption key are Railway variables only. Generate the key
# with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
INTEGRATION_ENCRYPTION_KEY=
# The "create your Shopify store" button: our Partner referral link.
SHOPIFY_SIGNUP_URL=https://www.shopify.com/free-trial
# <shop>.janoubona.net as a DNS-only CNAME to Shopify. A token scoped to
# Zone -> DNS -> Edit on that zone only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
STORE_SUBDOMAIN_BASE=janoubona.net

# --- Single-container production layout -----------------------------------
# When set, the API also serves the built SPA and injects SEO tags.
FRONTEND_DIST_DIR=
