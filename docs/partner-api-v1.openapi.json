  "components": {
    "schemas": {
      "Category": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name_ar": {
            "type": "string",
            "title": "Name Ar"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Icon"
          },
          "sort_order": {
            "type": "integer",
            "title": "Sort Order"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "business_count": {
            "type": "integer",
            "title": "Business Count",
            "default": 0
          },
          "item_count": {
            "type": "integer",
            "title": "Item Count",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "id",
          "name_ar",
          "slug",
          "sort_order",
          "is_active"
        ],
        "title": "Category"
      },
      "Currency": {
        "type": "string",
        "enum": [
          "USD",
          "LBP"
        ],
        "title": "Currency"
      },
      "EducationLevel": {
        "type": "string",
        "enum": [
          "SECONDARY_VOCATIONAL",
          "UNIVERSITY",
          "POSTGRADUATE"
        ],
        "title": "EducationLevel",
        "description": "The highest level a job seeker reached; the directory filters on it."
      },
      "GoodsOrigin": {
        "type": "string",
        "enum": [
          "LOCAL",
          "IMPORTED"
        ],
        "title": "GoodsOrigin",
        "description": "Whether goods are made in the South or imported.\n\nTwo separate doors on both the offering and the looking-for pages, at the\nCEO's request: a southern store selling imported goods is welcome, but a\nbuyer looking for what the South itself produces must be able to tell the\ntwo apart. Carried by each *product*, so a shop selling both registers\nonce and its goods appear under both doors; the shop's own mark is the\ndoor it came through and the default its new products take. Public,\nbecause it is exactly what a visitor filters on."
      },
      "Location": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name_ar": {
            "type": "string",
            "title": "Name Ar"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "type": {
            "$ref": "#/components/schemas/LocationType"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "sort_order": {
            "type": "integer",
            "title": "Sort Order"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "business_count": {
            "type": "integer",
            "title": "Business Count",
            "default": 0
          },
          "item_count": {
            "type": "integer",
            "title": "Item Count",
            "default": 0
          },
          "service_count": {
            "type": "integer",
            "title": "Service Count",
            "default": 0
          },
          "job_count": {
            "type": "integer",
            "title": "Job Count",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "id",
          "name_ar",
          "slug",
          "type",
          "sort_order",
          "is_active"
        ],
        "title": "Location"
      },
      "LocationType": {
        "type": "string",
        "enum": [
          "GOVERNORATE",
          "DISTRICT",
          "TOWN"
        ],
        "title": "LocationType"
      },
      "ProductPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Product"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "PartnerPage[Product]"
      },
      "StorePage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Store"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "PartnerPage[Store]"
      },
      "TalentPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Freelancer"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "PartnerPage[Freelancer]"
      },
      "Product": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "store_slug": {
            "type": "string",
            "title": "Store Slug"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "price": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "images": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Images",
            "default": []
          },
          "goods_origin": {
            "$ref": "#/components/schemas/GoodsOrigin"
          },
          "page_url": {
            "type": "string",
            "title": "Page Url"
          },
          "buy_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Buy Url"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "store_slug",
          "title",
          "currency",
