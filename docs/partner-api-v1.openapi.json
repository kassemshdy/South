{
  "openapi": "3.1.0",
  "info": {
    "title": "Janoubona Partner API",
    "version": "1.0.0",
    "description": "Read-only feed of Janoubona's approved stores, available products and freelancers, with each store's Shopify storefront and buy links. It carries only what a visitor to janoubona.net can already read. Reference: docs/PARTNER_API.md."
  },
  "servers": [
    {
      "url": "https://www.janoubona.net",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Partner API v1"
    }
  ],
  "paths": {
    "/api/partner/v1/stores": {
      "get": {
        "tags": [
          "Partner API v1"
        ],
        "summary": "List stores",
        "operationId": "list_stores",
        "parameters": [
          {
            "name": "connected",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Only stores with a live Shopify store",
              "default": false,
              "title": "Connected"
            },
            "description": "Only stores with a live Shopify store"
          },
          {
            "name": "updated_since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Updated Since"
            },
            "description": "ISO 8601 timestamp. Only rows changed at or after this time."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            },
            "description": "Opaque. Pass back next_cursor from the previous page."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            },
            "description": "Page size, 1 to 200."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorePage"
                }
              }
            }
          },
          "401": {
            "description": "Missing, wrong or revoked API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "bad_api_key",
                    "message": "..."
                  }
                }
              }
            }
          },
          "403": {
            "description": "The key does not have the scope this route needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "scope_missing",
                    "message": "..."
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "rate_limited",
                    "message": "..."
                  }
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until the key may call again."
              }
            }
          },
          "422": {
            "description": "Invalid parameter or cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "bad_cursor",
                    "message": "..."
                  }
                }
              }
            }
          }
        },
        "description": "Approved stores, ordered by (updated_at, id), paged by cursor. Requires scope `stores:read`.",
        "security": [
          {
            "PartnerKey": []
          }
        ]
      }
    },
    "/api/partner/v1/stores/{slug}": {
