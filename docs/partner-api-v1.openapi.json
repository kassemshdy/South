              }
            }
          },
          "403": {
            "description": "The key does not have the scope this route needs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "scope_missing",
                    "message": "..."
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "rate_limited",
                    "message": "..."
                  }
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until the key may call again."
              }
            }
          },
          "404": {
            "description": "No approved store with this slug.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "not_found",
                    "message": "..."
                  }
                }
              }
            }
          }
        },
        "description": "One approved store by slug (percent-encoded). Requires scope `stores:read`.",
        "security": [
          {
            "PartnerKey": []
          }
        ]
      }
    },
