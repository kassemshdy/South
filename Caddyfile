# TLS is obtained and renewed automatically for {$DOMAIN}.
{$DOMAIN} {
	encode zstd gzip

	# Uploaded images are immutable (content-addressed filenames).
	@media path /media/*
	header @media Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The web service serves the SPA and proxies API paths onward.
	reverse_proxy web:8080
}
